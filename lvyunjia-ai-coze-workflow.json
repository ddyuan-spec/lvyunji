{
  "schema_version": "1.0.0",
  "name": "绿韵家AI创作",
  "description": "基于泰小虎图片识别工作流(txh_center_optimize)范式重设计：主工作流编排 + 4子工作流 + 记忆库。",
  "main": {
    "id": "100000",
    "name": "ai_create_orchestrator",
    "nodes": [
      {
        "id": "100001",
        "type": "start",
        "title": "开始",
        "parameters": {
          "purpose": "接收前端下发意图与全部参数",
          "node_outputs": {
            "intent": "生成图片/生成视频/做同款",
            "user_text": "文本",
            "selected_tags": "[]",
            "voice_text": "?",
            "reference_images": "[]",
            "model": "",
            "ratio": "",
            "clarity": "",
            "duration": ""
          }
        }
      },
      {
        "id": "100002",
        "type": "code",
        "title": "输入归一化",
        "parameters": {
          "purpose": "复用泰小虎图片识别范式：标签→结构化描述、参考图URL抽取、语音文本归一化",
          "memory": {
            "action": "write",
            "key": "session:{conv_id}",
            "content": "本次会话上下文"
          },
          "settingOnError": {
            "processType": 1,
            "retryTimes": 0,
            "timeoutMs": 30000
          },
          "node_inputs": [
            "user_text",
            "selected_tags",
            "voice_text",
            "reference_images"
          ],
          "node_outputs": {
            "normalized_input": "结构化输入"
          }
        }
      },
      {
        "id": "100003",
        "type": "llm",
        "title": "意图与场景识别",
        "parameters": {
          "purpose": "复用泰小虎意图识别范式：判断 生图/生视频/做同款，提取风格/比例/时长，强制JSON",
          "settingOnError": {
            "processType": 1,
            "retryTimes": 1,
            "timeoutMs": 180000
          },
          "node_inputs": [
            "normalized_input"
          ],
          "node_outputs": {
            "scene_type": "image|video|same",
            "structured_params": "{}",
            "rewritten_query": ""
          }
        }
      },
      {
        "id": "100004",
        "type": "condition",
        "title": "是否需提示词增强",
        "parameters": {
          "purpose": "用户已填完整prompt则跳过子工作流A",
          "node_inputs": [
            "scene_type",
            "prompt"
          ]
        }
      },
      {
        "id": "100005",
        "type": "sub_workflow",
        "title": "子工作流A·提示词增强",
        "parameters": {
          "purpose": "调用 prompt_enhance，返回 enhanced_prompt",
          "memory": {
            "action": "read_write",
            "key": "user_style:{user_id}",
            "read_for": "默认填充辅助生图",
            "write_from": "扩写后累积画像"
          },
          "node_inputs": [
            "normalized_input",
            "scene_type"
          ],
          "node_outputs": {
            "enhanced_prompt": ""
          }
        }
      },
      {
        "id": "100006",
        "type": "condition",
        "title": "生成类型路由",
        "parameters": {
          "purpose": "按 scene_type 路由到图片/视频子工作流",
          "node_inputs": [
            "scene_type"
          ]
        }
      },
      {
        "id": "100007",
        "type": "sub_workflow",
        "title": "子工作流B·图片生成",
        "parameters": {
          "purpose": "调用 image_generate，返回 image_result",
          "memory": {
            "action": "read_write",
            "key": "额度账户(业务库)",
            "note": "读额度校验、写扣减"
          },
          "node_inputs": [
            "enhanced_prompt",
            "model",
            "ratio"
          ],
          "node_outputs": {
            "image_result": ""
          }
        }
      },
      {
        "id": "100008",
        "type": "sub_workflow",
        "title": "子工作流C·视频生成",
        "parameters": {
          "purpose": "调用 video_generate，返回 video_result",
          "memory": {
            "action": "read_write",
            "key": "额度账户(业务库)"
          },
          "node_inputs": [
            "enhanced_prompt",
            "model",
            "clarity",
            "duration"
          ],
          "node_outputs": {
            "video_result": ""
          }
        }
      },
      {
        "id": "100009",
        "type": "sub_workflow",
        "title": "子工作流D·作品后处理",
        "parameters": {
          "purpose": "调用 post_process，返回 work_record",
          "memory": {
            "action": "write",
            "key": "user_prompt_tpl:{user_id} / user_gen_stat:{user_id}",
            "write_when": "成功生成后"
          },
          "node_inputs": [
            "gen_result",
            "user_id"
          ],
          "node_outputs": {
            "work_record": ""
          }
        }
      },
      {
        "id": "100010",
        "type": "memory_write",
        "title": "写用户记忆",
        "parameters": {
          "purpose": "把本次成功生成的风格偏好/提示词模板写入长期记忆（累积画像）",
          "memory": {
            "action": "write",
            "key": "user_style:{user_id}, user_prompt_tpl:{user_id}, user_gen_stat:{user_id}"
          },
          "settingOnError": {
            "processType": 1,
            "retryTimes": 1,
            "timeoutMs": 10000
          },
          "node_inputs": [
            "work_record"
          ],
          "node_outputs": {
            "mem_ok": "true"
          }
        }
      },
      {
        "id": "100011",
        "type": "variable_merge",
        "title": "变量聚合",
        "parameters": {
          "purpose": "聚合各子工作流产物",
          "node_inputs": [
            "各分支输出"
          ],
          "node_outputs": {
            "merged": ""
          }
        }
      },
      {
        "id": "100012",
        "type": "end",
        "title": "结束",
        "parameters": {
          "purpose": "返回最终结果与各中间产物",
          "node_inputs": [
            "merged"
          ],
          "node_outputs": {
            "result": ""
          }
        }
      }
    ],
    "edges": [
